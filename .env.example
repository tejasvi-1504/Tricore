
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=krevol

# ── Pricing (INR) ────────────────────────────────────────────────────────────
# These are fallbacks. The admin panel's Prices panel sets the real ones and
# they win, which needs no redeploy; these only apply where nothing has been
# set there. Keep them in step anyway, so clearing settings cannot resurrect
# an older set of numbers.
PRICE_TRIAL=149        # the first 1:1 call, charged once per email address
PRICE_MONTHLY=1999     # the full month: 4 weekends, 8 classes
PRICE_REGULAR=1999     # what the month is struck through against
                       # leave equal to PRICE_MONTHLY when there is no offer
# Every 1:1 after the first. Leave blank and it follows the month: the monthly
# price over its four weekends, so a single call can never undercut the
# programme it introduces.
PRICE_SESSION=

# ── Payments ─────────────────────────────────────────────────────────────────
# 'razorpay' -> live card / UPI / netbanking checkout. This is the one in use.
# 'manual'   -> the booking is stored, the student is handed a WhatsApp link
#               pre-filled with their details, and you confirm + collect payment
#               by hand. No gateway keys needed. This is the default.
# 'cashfree' -> routes the same booking through the payment gateway instead.
#               Switch to this once the volume justifies automating it.
PAYMENT_MODE=razorpay

# Bookings and enquiries are sent to this WhatsApp number.
WHATSAPP_NUMBER=919410891738

# ── Cashfree Payment Gateway ─────────────────────────────────────────────────
# From https://merchant.cashfree.com → Developers → API Keys.
# Only needed once a price above is set.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 'sandbox' for testing, 'production' for live money.
CASHFREE_ENV=sandbox

# ── Email notifications ──────────────────────────────────────────────────────
# Where booking + enquiry notifications are delivered.
BOOKING_EMAIL=itskanishka1202@gmail.com

# Gmail SMTP. Use a Google App Password, NOT your account password:
# Google Account → Security → 2-Step Verification → App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=itskanishka1202@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Kanishka Creates <itskanishka1202@gmail.com>

# ── Site ─────────────────────────────────────────────────────────────────────
# Used to build the Cashfree return URL and webhook URL. Leave empty to derive
# it from the incoming request (fine for most setups).
SITE_URL=

# ── Admin panel ──────────────────────────────────────────────────────────────
# Password for /admin.html, where you confirm payments and release seats.
# Minimum 8 characters; the panel refuses to run without it. Changing this
# immediately signs out every existing admin session.
ADMIN_PASSWORD=pick-a-long-random-password

# ── Google Meet ──────────────────────────────────────────────────────────────
# A permanent Meet room, sent as a "Join with Google Meet" button in the
# confirmation email for online sessions. Optional: the admin panel can set
# this instead, which is easier because it needs no redeploy. A booking may
# also carry its own meetLink, which wins over both.
MEET_LINK=

# ── Razorpay ─────────────────────────────────────────────────────────────────
# From https://dashboard.razorpay.com -> Settings -> API Keys.
# The key id is public and reaches the browser; the secret never leaves the
# server. Test keys start rzp_test_, live keys rzp_live_ — the panel shows
# which one is in use so you cannot take real money by accident.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Settings -> Webhooks. Point it at https://your-domain/api/payment-webhook and
# subscribe to payment.captured and order.paid. This secret is separate from
# the API secret above.
RAZORPAY_WEBHOOK_SECRET=
